VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_ENV=local
# Activa el CRM de demostracion sin llamadas al servidor remoto.
VITE_DEMO_MODE=false
# Solo desarrollo local: servicio que normaliza CSV/XLS/XLSX sin persistir contactos.
VITE_AGENT_LOCAL_URL=http://localhost:8000

# Edge Function secrets for Gmail API. Do not expose these in frontend code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_SENDER=msanhueza@latinchile.cl
GMAIL_TOKEN_ENCRYPTION_KEY=

# Edge Function secrets for Meta WhatsApp Cloud API. Never expose these in VITE_* variables.
META_GRAPH_API_VERSION=v25.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
# Keep false until Meta has approved the app for production.
META_WHATSAPP_PRODUCTION_APPROVED=false

# Redirect URI — must be registered in Google Cloud Console > Credentials > OAuth Client > Authorized redirect URIs.
# Local (Supabase CLI):
GOOGLE_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/gmail-integration/callback
# Self-hosted (update host to match your Supabase URL):
# GOOGLE_REDIRECT_URI=http://crm-climactiva-supabase-ff88c0-187-77-53-52.sslip.io/functions/v1/gmail-integration/callback
# Production (Supabase hosted):
# GOOGLE_REDIRECT_URI=https://YOUR-PROJECT.supabase.co/functions/v1/gmail-integration/callback

# CRM frontend URL — used for CORS and OAuth redirects back to the app.
CRM_APP_URL=http://localhost:5173
# Production:
# CRM_APP_URL=https://crm.latinchile.cl

# Edge Function secrets for the secure OpenAI copilot. Do not expose these as VITE_ variables.
COPILOT_ENABLED=true
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_REASONING_EFFORT=
OPENAI_STORE_RESPONSES=false
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_TOOL_ROUNDS=2
OPENAI_MAX_OUTPUT_TOKENS=900
