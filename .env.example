VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_ENV=local
# Activa el CRM de demostracion sin llamadas al servidor remoto.
VITE_DEMO_MODE=false
# Origen HTTPS del normalizador remoto (sin ruta); requiere la sesión del CRM.
# Vacío: importación deshabilitada, sin fallback al PC.
VITE_HISTORICAL_IMPORT_URL=

# Edge Function secrets for Gmail API. Do not expose these in frontend code.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_SENDER=msanhueza@latinchile.cl
GMAIL_TOKEN_ENCRYPTION_KEY=

# Edge Function secrets for Meta WhatsApp Cloud API. Never expose these in VITE_* variables.
META_GRAPH_API_VERSION=v25.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
# Keep false until Meta has approved the app for production.
META_WHATSAPP_PRODUCTION_APPROVED=false

# Redirect URI — must be registered in Google Cloud Console > Credentials > OAuth Client > Authorized redirect URIs.
# Local (Supabase CLI):
GOOGLE_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/gmail-integration/callback
# Self-hosted (update host to match your Supabase URL):
# GOOGLE_REDIRECT_URI=http://crm-climactiva-supabase-ff88c0-187-77-53-52.sslip.io/functions/v1/gmail-integration/callback
# Production (Supabase hosted):
# GOOGLE_REDIRECT_URI=https://YOUR-PROJECT.supabase.co/functions/v1/gmail-integration/callback

# CRM frontend URL — used for CORS and OAuth redirects back to the app.
CRM_APP_URL=http://localhost:5173
# Production:
# CRM_APP_URL=https://crm.latinchile.cl

# Edge Function secrets for the secure OpenAI copilot. Do not expose these as VITE_ variables.
COPILOT_ENABLED=true
# Server only. DeepSeek reuses the encrypted key saved in Prospeccion.
COPILOT_DEFAULT_MODEL_CHOICE=deepseek:deepseek-v4-pro
COPILOT_DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-flash
# Optional JSON override: {"model-id":{"input":USD_per_million,"output":USD_per_million}}
COPILOT_DEEPSEEK_RATES_JSON=
OPENAI_API_KEY=
# Central business copilot. Backend only; no VITE_ prefix.
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_ESCALATION_MODEL=gpt-5.6-sol
OPENAI_MODEL_MODE=auto
OPENAI_SOL_AUTO_ESCALATION=true
OPENAI_MAX_SOL_CALLS_PER_REQUEST=1
OPENAI_COST_GUARD_ENABLED=true
DAILY_OPENAI_BUDGET_USD=5
# Optional smaller Sol allowance; otherwise shares the total daily budget.
DAILY_OPENAI_SOL_BUDGET_USD=
WARNING_OPENAI_BUDGET_PERCENT=70
ECONOMY_MODE=true
OPENAI_LUNA_INPUT_USD_PER_MILLION=0.2
OPENAI_LUNA_OUTPUT_USD_PER_MILLION=1.2
OPENAI_SOL_INPUT_USD_PER_MILLION=4
OPENAI_SOL_OUTPUT_USD_PER_MILLION=20
OPENAI_ROUTER_MAX_OUTPUT_TOKENS=2400
OPENAI_SPECIALIST_MAX_OUTPUT_TOKENS=1600
OPENAI_TEST_MAX_OUTPUT_TOKENS=512
OPENAI_MAX_MODEL_CALLS_PER_REQUEST=32
OPENAI_MAX_CONTEXT_BYTES=200000
OPENAI_RESPONSE_CACHE_TTL_SECONDS=60
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
COPILOT_LIVE_ENABLED=true
# Gemini Live is an alternative audio transport; permanent key is backend-only.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_SESSION_SECONDS=900
COPILOT_GEMINI_LIVE_ENABLED=true
COPILOT_DEFAULT_VOICE_PROVIDER=gemini
# Observability only. Update rates when the provider changes its pricing.
OPENAI_LIVE_USD_PER_MINUTE=0.05
OPENAI_INPUT_USD_PER_MILLION=4
OPENAI_OUTPUT_USD_PER_MILLION=20
COPILOT_TIMEOUT_MS=50000
COPILOT_SOURCE_TIMEOUT_MS=20000
COPILOT_SESSION_DAYS=30
COPILOT_HISTORY_MESSAGES=12
COPILOT_MAX_OUTPUT_TOKENS=2400
OPENAI_REASONING_EFFORT=auto
OPENAI_STORE_RESPONSES=false
OPENAI_REQUEST_TIMEOUT_MS=30000
OPENAI_MAX_TOOL_ROUNDS=2
OPENAI_MAX_OUTPUT_TOKENS=900

# Intelligent Content Center. Backend secrets only; never expose as VITE_*.
OPENAI_CONTENT_MODEL=gpt-4.1-mini
META_SOCIAL_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
CONTENT_SCHEDULER_SECRET=
