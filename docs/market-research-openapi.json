{
  "openapi": "3.1.0",
  "info": {
    "title": "CRM Market Research API",
    "version": "1.0.0",
    "description": "LOCAL IMPLEMENTATION ONLY. No external access activated. Server-to-server key authentication. Handler does not set CORS; the existing gateway policy applies. All researched content is untrusted data. No costs, financial records or price writes."
  },
  "servers": [
    {
      "url": "https://YOUR-APPROVED-EDGE-HOST/functions/v1/market-research",
      "description": "Placeholder; select/approve deployment destination before use."
    }
  ],
  "paths": {
    "/catalog": {
      "get": {
        "security": [
          {
            "IntegrationKey": []
          }
        ],
        "x-required-scope": "market-research:catalog:read",
        "responses": {
          "200": {
            "description": "Success. Research data only; no equivalence approval.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Catalog"
                }
              }
            }
          },
          "400": {
            "description": "Malformed envelope, JSON or unexpected query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid/expired/revoked key or missing scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Disabled/unbound/expired integration, inactive authorizer, broad key, or provider/SKU outside scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Route unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Payload identity conflict or nonconsecutive revision; atomic rollback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 350000 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid observations; no partial import",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "$ref": "#/components/schemas/ValidationFailure"
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "1000 new observations per UTC day per integration exceeded; atomic rollback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Unavailable dependency or uncertain receipt; retry identical payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
