          "pilot_usd",
          "daily_jobs",
          "public_hosts"
        ],
        "properties": {
          "schema_version": {
            "const": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "revision": {
            "type": "integer"
          },
          "choice": {
            "type": "string"
          },
          "daily_usd": {
            "type": "number"
          },
          "pilot_usd": {
            "type": "number"
          },
          "daily_jobs": {
            "type": "integer"
          },
