            "format": "uuid"
          },
          "state": {
            "enum": [
              "running",
              "completed",
              "failed",
              "unknown"
            ]
          },
          "selection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision",
              "provider",
              "model",
              "input_usd_per_million",
              "output_usd_per_million",
              "rate_source",
              "rate_checked_at"
            ],
            "properties": {
              "revision": {
                "type": "integer"
              },
              "provider": {
                "enum": [
                  "deepseek",
                  "openai"
                ]
              },
              "model": {
                "type": "string"
              },
              "input_usd_per_million": {
                "type": "number"
              },
              "output_usd_per_million": {
                "type": "number"
              },
              "rate_source": {
                "type": "string"
              },
              "rate_checked_at": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "sku": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "attributes": {
            "type": "array",
            "maxItems": 9,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "value",
                "quote"
              ],
              "properties": {
                "field": {
                  "enum": [
                    "title",
                    "brand",
                    "model",
                    "price",
                    "currency",
                    "vat",
                    "unit",
                    "package_quantity",
                    "availability"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
