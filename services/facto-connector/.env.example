# Backend-only configuration. Never expose these values through VITE_* variables.
CRM_AGENT_URL=https://your-supabase-project/functions/v1/crm-agent
CRM_AGENT_API_KEY=replace-in-the-server-secret-manager

FACTO_API_BASE_URL=https://apifacto.com/v1
FACTO_API_CLIENT_ID=replace-in-the-server-secret-manager
FACTO_API_CLIENT_SECRET=replace-in-the-server-secret-manager
FACTO_API_RESOURCE_OWNER_NAME=replace-in-the-server-secret-manager
FACTO_API_RESOURCE_OWNER_PASSWORD=replace-in-the-server-secret-manager
FACTO_API_ISSUED_FLAG=1
FACTO_CURRENCY_MAP_JSON={"5":"USD","38":"EUR","39":"CLP"}
FACTO_API_MAX_RETRIES=2
FACTO_API_RETRY_BASE_MS=1000
FACTO_API_MAX_RETRY_DELAY_MS=60000

FACTO_WEB_BASE_URL=https://minegocio.facto.cl
FACTO_WEB_LOGIN_URL=https://minegocio.facto.cl
# Configure the exact Documentos Impagos URL after the controlled Phase 4 test.
# FACTO_WEB_UNPAID_URL=https://minegocio.facto.cl/verified-read-only-path
FACTO_WEB_USERNAME=replace-in-the-server-secret-manager
FACTO_WEB_PASSWORD=replace-in-the-server-secret-manager
FACTO_WEB_HEADLESS=true
# Use the locally installed Chrome in Phase 4. Omit on a server with Playwright Chromium installed.
FACTO_BROWSER_CHANNEL=chrome
FACTO_BROWSER_MAX_PAGES=100
FACTO_EVIDENCE_DIR=.facto-evidence

# Run once by default. Use the watch script only after Phase 4 approval.
FACTO_WORKER_POLL_SECONDS=30
