+async def run_monitor(
+    monkeypatch, *, incomplete=False, details_fail=False, note_detail_fails=False, web_enabled=False
+):
+    invoice = {"document_id": 731, "type_id": 2, "received_issued_flag": 1}
+    exempt = {"document_id": 800, "type_id": 32, "received_issued_flag": 1}
+    purchase = {"document_id": 900, "type_id": 28, "received_issued_flag": 0}
+    debit = {"document_id": 801, "type_id": 17, "received_issued_flag": 1}
+    details = {
+        762: note80_detail(),
+        **{row["document_id"]: row for row in [invoice, exempt, purchase, debit]},
+    }
+    if note_detail_fails:
+        details[762] = RuntimeError("offline document failure")
+    rows = [note80(), invoice, exempt, purchase, debit]
+    settings = SimpleNamespace(
+        facto_enabled=True,
+        tiendanube_enabled=web_enabled,
+        facto_receivables_resource="",
+        facto_sync_interval_minutes=5,
+        tiendanube_sync_interval_minutes=5,
+    )
+
+    class Client(DocumentClient):
+        async def health(self):
+            return SimpleNamespace(configured=True, connected=True, message="offline fixture")
+
+        async def products(self, **kwargs):
+            return []
+
+        async def customers(self, **kwargs):
+            return []
+
+        async def inbox_documents(self, **kwargs):
+            return []
+
+        async def payments(self, **kwargs):
+            return []
+
+        async def orders(self, **kwargs):
+            return []
+
+    client = Client({1: {"documents": rows, "page_count": 1}}, details)
+    batches, reports, snapshot_inputs = [], [], {}
+
+    class CRM:
+        async def report_integration(self, **kwargs):
+            reports.append(deepcopy(kwargs))
+
+        async def upsert_integration_records(self, **kwargs):
+            batches.append(deepcopy(kwargs))
+
+    def capture(name):
+        def snapshot(*args, **kwargs):
+            snapshot_inputs[name] = deepcopy((args, kwargs))
+            return []
+
+        return snapshot
+
+    async def stop_after_cycle(_seconds):
+        raise asyncio.CancelledError
+
+    if incomplete:
+
+        async def partial(_client):
+            raise worker.FactoDocumentLoadIncomplete(
+                rows[:-2] + [debit], [purchase], pages=20, reason="max_pages"
+            )
+
+        monkeypatch.setattr(worker, "load_facto_financial_documents", partial)
+    if details_fail:
+
+        async def unavailable(*_args, **_kwargs):
+            raise RuntimeError("offline detail failure")
+
+        monkeypatch.setattr(worker, "load_facto_details", unavailable)
+    monkeypatch.setattr(worker, "get_settings", lambda: settings)
+    monkeypatch.setattr(worker, "FactoClient", lambda _settings: client)
+    monkeypatch.setattr(worker, "TiendanubeClient", lambda _settings: client)
+    monkeypatch.setattr(worker, "extract_product_snapshots", capture("inventory"))
+    monkeypatch.setattr(worker, "extract_financial_snapshot", capture("financial"))
+    monkeypatch.setattr(worker, "extract_commercial_snapshot", capture("commercial"))
+    monkeypatch.setattr(worker.asyncio, "sleep", stop_after_cycle)
+    with pytest.raises(asyncio.CancelledError):
+        await worker.integration_monitor(CRM())
+    return batches, reports, snapshot_inputs
+
