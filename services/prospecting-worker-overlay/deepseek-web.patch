+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import httpx
+import pytest
+
+from app.crm.fake import FakeCRMPort
+from app.crm.http import HttpCRMPort
+from app.crm.port import CRMRetryableError
+from app.prospecting.contracts import ProspectingCampaign, ProspectingRunSnapshot, SourceName, Territory
+from app.prospecting.sources import StaticSourceExecutor
+from app.prospecting.store import MemoryWorkerStore, expand_task_specs
+from app.prospecting.worker import ProspectingWorker
+
+
+def snapshot():
+    return ProspectingRunSnapshot(crm_run_id="run", campaign_version=1, requested_by="admin", deepseek_enabled=True,
+        campaign=ProspectingCampaign(crm_campaign_id="campaign", name="Native",
+            sources=(SourceName.deepseek_web, SourceName.google_places, SourceName.official_website),
+            keywords=("climatizacion", "refrigeracion"), territories=(Territory(region_code="13",
+                region_name="Metropolitana", comuna_code="13101", comuna_name="Santiago"),)))
+
+
+@pytest.mark.asyncio
+async def test_native_tasks_run_before_places_and_send_candidates_to_crm_queue(monkeypatch):
+    crm, store, source = FakeCRMPort(), MemoryWorkerStore(), StaticSourceExecutor([])
+    scope = snapshot()
+    assert len(expand_task_specs(scope)) == 4
+    await crm.enqueue(scope)
+    calls = []
+    async def research(run_id, operation_id, kind, lease):
+        calls.append(kind)
+        return {"status": "applied", "added": 19, "discoveries": [{"website": "https://andes.cl"}], "web_requests": 3}
+    monkeypatch.setattr(crm, "research", research, raising=False)
+    original = source.search
+    async def search(task, scope):
+        assert task.source == SourceName.google_places
+        assert calls == ["discovery", "discovery"]
+        return await original(task, scope)
+    monkeypatch.setattr(source, "search", search)
+    await ProspectingWorker(crm, store, source).poll_once()
+    remote = await crm.inspect_run("run")
+    native = [event for event in remote.events if event.source == SourceName.deepseek_web and event.stage == "task_completed"]
+    assert len(native) == 2
+    assert all(event.metrics["candidates_staged"] == 19 for event in native)
+
+
+@pytest.mark.asyncio
+async def test_social_candidate_uses_native_lookup_then_official_validation(monkeypatch):
+    from app.prospecting.contracts import ProspectCandidate, ProspectLocation
+    crm, store, source = FakeCRMPort(), MemoryWorkerStore(), StaticSourceExecutor([])
+    seed = ProspectCandidate(location=ProspectLocation(), name="Clima Andes", website="https://instagram.com/climaandes", market_signals={"deepseek_discovery": True})
+    job = SimpleNamespace(candidate=seed, snapshot=snapshot(), run_id="run", job_id="job", lease_token="lease")
+    source._is_official_website_candidate = lambda _: False
+    source.validate_discovery = AsyncMock(return_value=(seed, {"validation_accepted": False}))
+    monkeypatch.setattr(crm, "research", AsyncMock(return_value={"status": "applied", "discoveries": [{"website": "https://climaandes.cl"}]}), raising=False)
+    monkeypatch.setattr(crm, "complete_enrichment", AsyncMock())
+    await ProspectingWorker(crm, store, source)._process_enrichment(job)
+    source.validate_discovery.assert_awaited_once_with(seed, job.snapshot, ["https://climaandes.cl"])
+    crm.research.assert_awaited_once_with("run", "job", "validation", "lease")
+    crm.complete_enrichment.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_research_http_sends_lease_no_provider_key_and_handles_inflight_retry():
+    seen = []
+    def handler(request):
+        if request.url.path.endswith("/claim"):
+            assert "deepseek_research_v3" in json.loads(request.content)["capabilities"]
+            return httpx.Response(200, json={"run": None})
+        seen.append(json.loads(request.content))
+        return httpx.Response(200, json={"data": {"status": "preparing" if len(seen) == 1 else "applied"}})
+    port = HttpCRMPort(base_url="https://crm.test", api_key="fixture-crm-key", transport=httpx.MockTransport(handler))
+    await port.claim_run("worker")
+    await port.claim_enrichment("worker")
+    with pytest.raises(CRMRetryableError):
+        await port.research("run", "task", "discovery", "lease")
+    assert (await port.research("run", "task", "discovery", "lease"))["status"] == "applied"
+    assert seen[0] == seen[1] == {"worker_id": "worker", "operation_id": "task", "kind": "discovery", "lease_token": "lease"}
