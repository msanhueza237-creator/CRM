@@ -0,0 +1,155 @@
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+
+from app.crm.fake import FakeCRMPort
+from app.prospecting.contracts import ProspectCandidate, ProspectLocation, SourceName
+from app.prospecting.discovery_validation import validate_discovery
+from app.prospecting.sources import AuthorizedSourceExecutor, StaticSourceExecutor
+from app.prospecting.store import MemoryWorkerStore, expand_task_specs, WorkerTask
+from app.prospecting.worker import ProspectingWorker
+from tests.test_native_research import snapshot
+
+
+def scope():
+    return snapshot().model_copy(update={"discovery_strategy": "google_places_first"})
+
+
+@pytest.mark.asyncio
+async def test_google_hints_are_staged_before_contact_quality_and_not_lost_at_task_limit(monkeypatch):
+    crm, store = FakeCRMPort(), MemoryWorkerStore()
+    seeds = [ProspectCandidate(name=f"Empresa {i}", location=ProspectLocation(),
+        provider_ids={"google_places": f"place{i}"}) for i in range(35)]
+    source = StaticSourceExecutor(seeds)
+    calls = []
+    async def stage(run_id, task_id, lease_token, candidates):
+        calls.append(candidates)
+        return {"added": 35 if len(calls) == 1 else 0, "candidates_found": 35}
+    monkeypatch.setattr(crm, "stage_google", stage, raising=False)
+    monkeypatch.setattr(crm, "research", AsyncMock(side_effect=AssertionError("No DeepSeek discovery")), raising=False)
+    await crm.enqueue(scope())
+    assert len(expand_task_specs(scope())) == 2
+    assert all(t.source == SourceName.google_places for t in expand_task_specs(scope()))
+    await ProspectingWorker(crm, store, source).poll_once()
+    assert len(calls) == 2 and all(len(batch) == 35 for batch in calls)
+    remote = await crm.inspect_run("run")
+    events = [e for e in remote.events if e.stage == "task_completed"]
+    assert sum(e.metrics["candidates_staged"] for e in events) == 35
+    assert all(e.metrics["results_accepted"] == 0 for e in events)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("accepted", [True, False])
+async def test_every_google_hint_is_analyzed_even_with_official_website(monkeypatch, accepted):
+    crm, source = FakeCRMPort(), StaticSourceExecutor([])
+    seed = ProspectCandidate(name="Clima Andes", website="https://climaandes.cl", location=ProspectLocation(),
+        market_signals={"google_discovery": True})
+    job = SimpleNamespace(candidate=seed, snapshot=scope(), run_id="run", job_id="job", lease_token="lease")
+    source._is_official_website_candidate = lambda _: True
+    source.validate_discovery = AsyncMock(return_value=(seed, {}))
+    urls = [seed.website] if accepted else []
+    monkeypatch.setattr(crm, "research", AsyncMock(return_value={"status": "applied", "analysis_version": "climactiva-google-v1",
+        "analysis_accepted": accepted, "discoveries": [{"website": url} for url in urls]}), raising=False)
+    monkeypatch.setattr(crm, "complete_enrichment", AsyncMock())
+    await ProspectingWorker(crm, MemoryWorkerStore(), source)._process_enrichment(job)
+    crm.research.assert_awaited_once()
+    source.validate_discovery.assert_awaited_once_with(seed, job.snapshot, urls)
+    assert crm.complete_enrichment.call_args.args[2]["analysis_accepted"] == accepted
+
+
+@pytest.mark.asyncio
+async def test_empty_analysis_never_falls_back_to_unapproved_original_website():
+    executor = AuthorizedSourceExecutor()
+    executor._enrich_official_website = AsyncMock(side_effect=AssertionError("No crawl without accepted analysis"))
+    seed = ProspectCandidate(name="Clima Andes", website="https://climaandes.cl", location=ProspectLocation(), market_signals={"google_discovery": True})
+    candidate, summary = await validate_discovery(executor, seed, scope(), [])
+    assert not candidate.import_eligible
+    assert summary["official_pages_verified"] == 0
+
+
+@pytest.mark.asyncio
+async def test_five_google_queries_all_pages_and_no_inline_crawl(monkeypatch):
+    calls = []
+    address = [{"types": ["administrative_area_level_1"], "longText": "Region Metropolitana de Santiago"},
+        {"types": ["administrative_area_level_3"], "longText": "Santiago"},
+        {"types": ["country"], "shortText": "CL", "longText": "Chile"}]
+    class Google:
+        async def text_search_page(self, query, *, max_results, page_token):
+            calls.append((query, max_results, page_token))
+            page = int(page_token or "1")
+            return SimpleNamespace(places=[{"id": f"place{page}", "displayName": {"text": f"Empresa {page}"},
+                "addressComponents": address, "formattedAddress": "Santiago, Chile", "types": ["store"]},
+                {"id":"unrelated-mall","displayName":{"text":"Centro comercial"},"addressComponents":address,"types":["shopping_mall"]}],
+                next_page_token=str(page + 1) if page < 3 else None)
+        async def get_place_details(self, place_id):
+            assert place_id != "unrelated-mall", "Excluded businesses must not consume paid details"
+            return None
+    monkeypatch.setattr("app.prospecting.sources.GooglePlacesClient", Google)
+    executor = AuthorizedSourceExecutor()
+    executor.settings = executor.settings.model_copy(update={"google_places_queries_per_task": 1})
+    executor.budget = SimpleNamespace(reserve=AsyncMock(return_value=SimpleNamespace(allowed=True, alert=False,
+        run_spend_usd=0, daily_spend_usd=0, monthly_spend_usd=0)), complete=AsyncMock())
+    executor._enrich_official_website = AsyncMock(side_effect=AssertionError("Must stage first"))
+    task = WorkerTask(id="task", run_id="run", source=SourceName.google_places, keyword="climatizacion",
+        region_code="13", region_name="Metropolitana", comuna_code="13101", comuna_name="Santiago",
+        max_results=1, attempt_count=1, max_attempts=3)
+    result = await executor.search(task, scope())
+    assert len(set(c[0] for c in calls)) == 5
+    assert len(calls) == 15
+    assert all(c[1] == 20 and "Chile" in c[0] for c in calls)
+    assert len(result.candidates) == 3
+    assert result.metrics["raw_results"] == 30
+    assert result.metrics["unique_results"] == 4
+    assert result.metrics["discarded_excluded_business_type"] == 1
+
+
+@pytest.mark.parametrize("name,types", [
+    ("Rancagua Outlet Mall",["shopping_mall"]),("Ripley Rancagua",["department_store"]),
+    ("GMO",["optician"]),("Cenco Rancagua",["shopping_mall"]),("Neumamundo",["tire_shop"]),
+])
+def test_google_rejects_unrelated_business_types_even_after_many_query_hits(name,types):
+    from app.prospecting.quality import evaluate_google_discovery
+    assert not evaluate_google_discovery(name=name,place_types=types,independent_query_hits=6).allow_details
+
+
+@pytest.mark.parametrize("activity,address,expected", [
+    ("Tienda especializada en equipos de aire acondicionado",True,"retail"),
+    ("Tienda especializada en equipos de aire acondicionado",False,None),
+    ("Distribuidor online de equipos de climatizacion",True,None),
+    ("Empresa de instalacion y mantencion de climatizacion residencial",False,"services"),
+    ("Contratistas de refrigeracion industrial",True,"services"),
+    ("Empresa de servicios de aire acondicionado residencial",True,"services"),
+    ("Nuestras instalaciones cuentan con aire acondicionado",True,None),
+    ("Centro comercial con aire acondicionado",True,None),
+    ("Venta de neumaticos y reparacion de aire acondicionado automotriz",True,None),
+    ("No realizamos instalacion de aire acondicionado",True,None),
+])
+def test_commercial_channel_is_resale_premises_or_hvac_execution(activity,address,expected):
+    from app.prospecting.quality import commercial_channel
+    assert commercial_channel(activity,address)==expected
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("activity,expected", [
+    ("Tienda especializada y distribuidor de equipos de climatizacion", "retail"),
+    ("Servicio tecnico de instalacion y mantencion de aire acondicionado residencial", "services"),
+    ("Distribuidor online de equipos de climatizacion", "unconfirmed"),
+])
+async def test_official_research_admits_only_confirmed_climactiva_channels(monkeypatch, activity, expected):
+    from tests.test_prospecting_site_quality import enrichment, seed, scope as research_scope
+    campaign_scope = research_scope()
+    campaign_scope = campaign_scope.model_copy(update={"campaign": campaign_scope.campaign.model_copy(
+        update={"target_types": ("distribuidor", "tienda comercial", "tecnico", "instalador grande")})})
+    monkeypatch.setattr("app.prospecting.sources.enrich_from_website", AsyncMock(return_value=enrichment(description=activity)))
+    result, summary = await AuthorizedSourceExecutor().validate_discovery(seed(), campaign_scope)
+    assert summary["commercial_channel"] == expected
+    assert result.import_eligible == (expected != "unconfirmed"), result.review_flags
+    if expected == "unconfirmed":
+        assert "commercial_profile_unconfirmed" in result.review_flags
+
+
+def test_google_country_rejects_foreign_addresses_even_when_names_match_chile():
+    from app.prospecting.sources import _foreign_google_country
+    assert _foreign_google_country({"addressComponents": [{"types": ["country"], "shortText": "AR"}]})
+    assert not _foreign_google_country({"addressComponents": [{"types": ["country"], "shortText": "CL"}]})
