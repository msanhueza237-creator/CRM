@@ -0,0 +1,150 @@
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+import json
+
+import pytest
+
+from app.prospecting.contracts import ProspectCandidate, ProspectLocation, ProspectingCampaign, ProspectingRunSnapshot, SourceName, Territory
+from app.prospecting.sources import AuthorizedSourceExecutor, StaticSourceExecutor
+from app.prospecting.site_quality import site_issue, same_business
+from app.prospecting.worker import ProspectingWorker
+from app.prospecting.store import MemoryWorkerStore
+from app.crm.fake import FakeCRMPort
+from app.enrichment.web_scraper import _page_enrichment, SafeResponse
+
+
+def scope():
+    return ProspectingRunSnapshot(crm_run_id="run", campaign_version=1, requested_by="admin", deepseek_enabled=True,
+        campaign=ProspectingCampaign(crm_campaign_id="campaign", name="Tiendas Rancagua",
+            description="Tiendas y distribuidores de aire acondicionado", keywords=("aire acondicionado",),
+            sources=(SourceName.deepseek_web, SourceName.official_website), target_types=("distribuidor", "tienda comercial"),
+            territories=(Territory(region_code="06", region_name="OHiggins", comuna_code="06101", comuna_name="Rancagua"),)))
+
+
+def seed(website="https://climaandes.com/"):
+    return ProspectCandidate(name="Clima Andes", website=website, location=ProspectLocation(), market_signals={"deepseek_discovery": True})
+
+
+def enrichment(**changes):
+    return {"name": "Clima Andes", "source_url": "https://climaandes.com/", "description": "Distribuidor mayorista y tienda de equipos de aire acondicionado y refrigeracion comercial",
+        "phone": "+56721234567", "email": "ventas@climaandes.com",
+        "locations": [{"address": "Av. Republica 100", "comuna_name": "Rancagua", "region_name": "OHiggins", "country_code": "CL"}], **changes}
+
+
+@pytest.mark.parametrize("url", ["https://extremominero.com.ar/directorio-pyme/schuler-refrigeracion/", "https://clima.es/", "https://emplea.inacap.cl/aviso/hvac", "https://yelu.cl/category/refrigeracion", "https://portal.com/directorio-pyme/schuler/"])
+def test_foreign_and_directory_seeds_are_not_official(url):
+    assert site_issue(url)
+    assert not AuthorizedSourceExecutor._is_official_website_candidate(seed(url))
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("changes", [
+    {"name": "Extremo Minero", "email": "contacto@extremominero.com.ar", "phone": "+5492915666646"},
+    {"locations": [{"address": "Calle 1", "comuna_name": "Rancagua", "region_name": "OHiggins", "country_code": "AR"}]},
+    {"phone": "+5492915666646"},
+    {"description": "Restaurante y hotel con aire acondicionado para sus clientes"},
+    {"description": "Servicio tecnico de instalacion y mantencion de aire acondicionado"},
+    {"description": None}, {"phone": None, "email": None},
+])
+async def test_wrong_identity_country_activity_or_missing_contact_cannot_qualify(monkeypatch, changes):
+    monkeypatch.setattr("app.prospecting.sources.enrich_from_website", AsyncMock(return_value=enrichment(**changes)))
+    candidate, summary = await AuthorizedSourceExecutor().validate_discovery(seed(), scope())
+    assert not candidate.import_eligible, candidate
+    assert not summary["validation_accepted"]
+    assert candidate.score == 0 and candidate.market_score == 0
+    if changes.get("name") == "Extremo Minero":
+        assert candidate.name == "Clima Andes" and candidate.phone is None and candidate.email is None
+
+
+@pytest.mark.asyncio
+async def test_chilean_distributor_on_com_domain_has_contact_activity_and_source(monkeypatch):
+    monkeypatch.setattr("app.prospecting.sources.enrich_from_website", AsyncMock(return_value=enrichment()))
+    candidate, summary = await AuthorizedSourceExecutor().validate_discovery(seed(), scope())
+    assert candidate.import_eligible, candidate.review_flags
+    assert candidate.phone == "+56721234567" and candidate.email == "ventas@climaandes.com"
+    assert candidate.description and candidate.location.comuna_code == "06101"
+    assert summary["validation_version"] == "public-web-v4"
+
+
+def test_site_identity_does_not_swap_company_for_directory():
+    assert not same_business("Schuler Refrigeracion", "Extremo Minero")
+    assert same_business("Clima Andes - Aire acondicionado", "Clima Andes SpA")
+
+
+@pytest.mark.asyncio
+async def test_plain_contact_address_works_without_jsonld_but_coverage_is_not_a_branch(monkeypatch):
+    html = '<title>Clima Andes</title><main><p>Tienda y distribuidor de aire acondicionado</p><p>Direccion: Av. Republica 100, Rancagua, Chile</p><p>Despachos a Rancagua y Nancagua por 10 pesos</p><a href="tel:+56721234567">Telefono</a></main>'
+    result, _ = _page_enrichment(SafeResponse(final_url="https://climaandes.com/", content=html.encode(), content_type="text/html"))
+    assert len(result["address_blocks"]) == 1
+    monkeypatch.setattr("app.prospecting.sources.enrich_from_website", AsyncMock(return_value=result))
+    candidate, _ = await AuthorizedSourceExecutor().validate_discovery(seed(), scope())
+    assert candidate.import_eligible, candidate.review_flags
+    assert candidate.location.comuna_code == "06101"
+    assert candidate.location.address == "Direccion: Av. Republica 100, Rancagua, Chile"
+
+
+def test_scraper_does_not_take_product_or_person_as_company():
+    html = '<script type="application/ld+json">' + json.dumps([
+        {"@type": "Product", "name": "Split 12000", "email": "producto@otro.cl"},
+        {"@type": "Person", "name": "Persona privada", "telephone": "+56911111111"},
+        {"@type": "HVACBusiness", "name": "Clima Andes", "telephone": "+56721234567", "address": {"streetAddress": "Av. Republica 100", "addressLocality": "Rancagua", "addressCountry": "Chile"}}
+    ]) + '</script>'
+    result, _ = _page_enrichment(SafeResponse(final_url="https://climaandes.com/", content=html.encode(), content_type="text/html"))
+    assert result["name"] == "Clima Andes"
+    assert result["phone"] == "+56721234567"
+    assert result["email"] is None
+    assert result["locations"][0]["country_code"] == "Chile"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("description,expected", [
+    ("Empresa de servicios de aire acondicionado residencial", "tecnico"),
+    ("Tienda y local comercial de refrigeracion", "tienda comercial"),
+    ("Empresa de mantencion y reparacion de sistemas de climatizacion residencial", "tecnico"),
+    ("Empresa de instalacion de sistemas de refrigeracion comercial", "tecnico"),
+    ("Contratista de proyectos industriales de climatizacion y refrigeracion", "instalador grande"),
+])
+async def test_climactiva_profile_accepts_verified_shops_services_and_projects(monkeypatch, description, expected):
+    snapshot = scope()
+    snapshot = snapshot.model_copy(update={"campaign": snapshot.campaign.model_copy(update={
+        "description": "Tiendas, distribuidores y empresas de servicios para trabajos y proyectos de Climactiva",
+        "target_types": ("distribuidor", "tienda comercial", "tecnico", "instalador grande"),
+    })})
+    monkeypatch.setattr("app.prospecting.sources.enrich_from_website", AsyncMock(return_value=enrichment(description=description)))
+    candidate, summary = await AuthorizedSourceExecutor().validate_discovery(seed(), snapshot)
+    assert candidate.import_eligible, candidate.review_flags
+    assert summary["validation_accepted"]
+    assert candidate.category == expected
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("description", [
+    "Tienda y distribuidor mayorista de ropa y calzado para empresas",
+    "Empresa de servicios de mantencion y reparacion de computadores y celulares",
+    "Distribuidor de alimentos refrigerados para restaurantes y supermercados",
+    "Empresa de instalacion y mantencion de sistemas de alarmas y camaras de seguridad",
+    "Empresa de servicios de aseo y limpieza residencial comercial e industrial",
+    "Restaurante y hotel con aire acondicionado para sus clientes",
+])
+async def test_generic_keywords_never_admit_other_industries(monkeypatch, description):
+    snapshot = scope()
+    snapshot = snapshot.model_copy(update={"campaign": snapshot.campaign.model_copy(update={
+        "keywords": ("tiendas", "distribuidores", "servicios", "mantencion", "reparacion", "instalacion"),
+        "target_types": ("distribuidor", "tienda comercial", "tecnico", "instalador grande"),
+    })})
+    monkeypatch.setattr("app.prospecting.sources.enrich_from_website", AsyncMock(return_value=enrichment(description=description)))
+    candidate, summary = await AuthorizedSourceExecutor().validate_discovery(seed(), snapshot)
+    assert not candidate.import_eligible
+    assert not summary["validation_accepted"]
+    assert candidate.score == 0 and candidate.market_score == 0
+
+
+@pytest.mark.asyncio
+async def test_budget_limit_defers_instead_of_retrying_as_bad_candidate(monkeypatch):
+    crm, sources = FakeCRMPort(), StaticSourceExecutor([])
+    job = SimpleNamespace(candidate=seed("https://instagram.com/climaandes"), snapshot=scope(), run_id="run", job_id="job", lease_token="lease")
+    sources._is_official_website_candidate = lambda _: False
+    monkeypatch.setattr(crm, "research", AsyncMock(return_value={"status": "limited", "reason_code": "DAILY_LIMIT"}), raising=False)
+    monkeypatch.setattr(crm, "fail_enrichment", AsyncMock())
+    await ProspectingWorker(crm, MemoryWorkerStore(), sources)._process_enrichment(job)
+    assert crm.fail_enrichment.await_args.args[1] == "ResearchDeferred: DAILY_LIMIT"
