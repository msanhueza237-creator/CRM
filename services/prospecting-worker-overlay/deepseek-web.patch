index 0000000..1468e85
--- /dev/null
+++ b/app/prospecting/site_quality.py
@@ -0,0 +1,67 @@
+"""Public business identity safeguards shared by discovery and enrichment."""
+import re
+from urllib.parse import urlsplit
+
+from unidecode import unidecode
+
+
+def site_issue(url: str | None) -> str | None:
+    parsed = urlsplit(url or "")
+    host = (parsed.hostname or "").lower().removeprefix("www.")
+    tld = host.split(".")[-1]
+    if len(tld) == 2 and tld not in {"cl", "io", "ai", "co", "tv"}:
+        return "foreign_country"
+    if re.search(r"(^|\.)(laguiaonline\.cl|yelu\.cl|cybo\.com|habitissimo\.cl|emplea\.inacap\.cl|auto-repair\.shop|yellowpages\.[a-z.]+)$", host):
+        return "directory_or_non_business"
+    if re.search(r"/(directorio[^/]*|directory|empleos?|jobs|ofertas?-?(laborales|empleo)?|noticias|news|tag|category|categoria)(/|$)", parsed.path, re.I):
+        return "directory_or_non_business"
+    return None
+
+
+def same_business(expected: str, observed: str) -> bool:
+    def tokens(value):
+        return set(re.findall(r"[a-z0-9]+", unidecode(value).lower())) - {
+            "de", "del", "la", "el", "y", "spa", "ltda", "sa", "chile", "inicio", "home",
+            "climatizacion", "refrigeracion", "aire", "acondicionado", "servicios", "empresa",
+            "tienda", "distribuidor", "distribuidores", "comercial", "industrial",
+        }
+    left, right = tokens(expected), tokens(observed)
+    return bool(left and right and (left <= right or right <= left))
+
+
+def chilean_country(value) -> bool:
+    if isinstance(value, dict):
+        value = value.get("name") or value.get("@id")
+    return unidecode(str(value or "")).strip().upper() in {"CL", "CHL", "CHILE"}
+
+
+def chilean_phone(value: str | None) -> bool:
+    return bool(re.fullmatch(r"\+56[2-9]\d{8}", value or ""))
+
+
+def same_site(left: str | None, right: str | None) -> bool:
+    def host(value):
+        return (urlsplit(value or "").hostname or "").lower().removeprefix("www.")
+    return bool(host(left) and host(left) == host(right))
+
+
+def generic_discovery_name(name: str, commune: str | None) -> bool:
+    value = unidecode(name).lower()
+    value = value.replace(unidecode(commune or "").lower(), "") if commune else value
+    words = set(re.findall(r"[a-z0-9]+", value))
+    return bool(words) and words <= {"aire", "acondicionado", "aires", "acondicionados", "climatizacion", "refrigeracion", "servicio", "servicios", "instalacion", "mantencion", "reparacion", "en", "de", "del", "la", "el", "y"}
+
+
+def matching_street(known_address: str | None, observed: str, commune: str | None) -> bool:
+    def normalized(value):
+        return " ".join(re.findall(r"[a-z0-9]+", unidecode(value or "").lower()))
+    known, actual, city = normalized(known_address), normalized(observed), normalized(commune)
+    if not city or not re.search(r"\b" + re.escape(city) + r"\b", actual):
+        return False
+    # Match the street text with its own civic number, not postal codes,
+    # contact numbers, broad service coverage or a shared commune alone.
+    for match in re.finditer(r"\b([a-z]+(?: [a-z]+){1,5}) (\d{1,5})\b", known):
+        words = match[1].split()[-2:]
+        if re.search(r"\b" + re.escape(" ".join(words) + " " + match[2]) + r"\b", actual):
+            return True
+    return False
