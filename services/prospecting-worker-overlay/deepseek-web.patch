+import asyncio
+from datetime import datetime, timedelta, timezone
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import httpx
+import pytest
+
+from app.crm.fake import FakeCRMPort
+from app.enrichment.web_scraper import SecureWebClient, SafeResponse, _page_enrichment, enrich_from_website
+from app.prospecting.contracts import ProspectCandidate, ProspectLocation, SourceEvidence, SourceName
+from app.prospecting.discovery_validation import validate_discovery
+from app.prospecting.sources import AuthorizedSourceExecutor
+from app.prospecting.store import MemoryWorkerStore
+from app.prospecting.worker import ProspectingWorker
+from tests.test_prospecting_site_quality import enrichment, scope
+from tests.test_secure_web_scraper import public_resolver
+
+
+def campaign():
+    s = scope()
+    return s.model_copy(update={'campaign': s.campaign.model_copy(update={'target_types': ('tecnico', 'tienda comercial')})})
+
+
+def seed_and_hint(name='Clima Andes', expired=False):
+    seed = ProspectCandidate(candidate_id='google:known', name=name, location=ProspectLocation(), market_signals={'google_discovery': True})
+    fields = {'name': name, 'website': 'https://climaandes.com/', 'phone': '+56721234567',
+        'location.address': 'Av. Republica 100, Rancagua', 'location.comuna_name': 'Rancagua'}
+    now = datetime.now(timezone.utc)
+    hint = ProspectCandidate(candidate_id=seed.candidate_id, name=name, website=fields['website'], phone=fields['phone'],
+        location=ProspectLocation(address=fields['location.address'], comuna_name='Rancagua'),
+        evidence=[SourceEvidence(provider=SourceName.google_places,field=k,value=v,source_url='https://maps.google.com/?cid=known',
+            observed_at=now-timedelta(days=31 if expired else 1), retention_until=now+timedelta(days=-1 if expired else 29)) for k,v in fields.items()])
+    return seed, hint
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('accepted', [False, True])
+async def test_current_hint_preserves_verified_fields_but_never_overrides_analysis(monkeypatch, accepted):
+    seed, hint = seed_and_hint()
+    read = AsyncMock(return_value=enrichment(description='Instalacion y reparacion de aire acondicionado residencial'))
+    monkeypatch.setattr('app.prospecting.sources.enrich_from_website', read)
+    result, summary = await validate_discovery(AuthorizedSourceExecutor(),seed,campaign(),[],known_hint=hint,analysis_accepted=accepted)
+    assert result.phone and result.email and result.location.address
+    assert result.import_eligible == accepted
+    assert summary['known_site_reused']
+    assert ('analysis_not_confirmed' in result.review_flags) != accepted
+    assert all(e.provider == SourceName.official_website for e in result.evidence)
+    assert not result.provider_ids.get('google_places')
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('invalid', ['expired','identity','website'])
+async def test_invalid_hints_do_not_authorize_a_crawl(monkeypatch, invalid):
+    seed, hint = seed_and_hint(expired=invalid=='expired')
+    if invalid=='identity': hint=hint.model_copy(update={'candidate_id':'another'})
+    if invalid=='website': hint=hint.model_copy(update={'website':'https://other.cl'})
+    read = AsyncMock(side_effect=AssertionError('No ungrounded crawl'))
+    monkeypatch.setattr('app.prospecting.sources.enrich_from_website', read)
+    result, _ = await validate_discovery(AuthorizedSourceExecutor(),seed,campaign(),[],known_hint=hint,analysis_accepted=True)
+    assert not result.import_eligible
+    read.assert_not_awaited()
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('address,expected', [('Av. Republica 100, Rancagua',True),('Av. Republica 101, Rancagua',False),('Av. Republica 100, Santiago',False)])
+async def test_generic_google_name_requires_exact_site_and_matching_physical_address(monkeypatch,address,expected):
+    seed, hint = seed_and_hint('Aire acondicionado en Rancagua')
+    monkeypatch.setattr('app.prospecting.sources.enrich_from_website',AsyncMock(return_value=enrichment(
+        description='Instalacion de sistemas de aire acondicionado',locations=[],address_blocks=[{'text':address,'source_url':hint.website}])) )
+    result, summary=await validate_discovery(AuthorizedSourceExecutor(),seed,campaign(),[],known_hint=hint,analysis_accepted=True)
+    assert bool(summary['official_pages_verified']) == expected
+    if expected: assert result.name=='Clima Andes'
+    else: assert not result.email and not result.import_eligible
+
+
+@pytest.mark.asyncio
+async def test_distinct_brand_cannot_be_replaced_even_at_same_address(monkeypatch):
+    seed,hint=seed_and_hint('Otra Marca')
+    monkeypatch.setattr('app.prospecting.sources.enrich_from_website',AsyncMock(return_value=enrichment()))
+    result,_=await validate_discovery(AuthorizedSourceExecutor(),seed,campaign(),[],known_hint=hint,analysis_accepted=True)
+    assert 'official_identity_conflict' in result.review_flags
+    assert not result.email and not result.import_eligible
+
+
+@pytest.mark.asyncio
+async def test_site_timeout_stays_pending_and_is_cached_for_the_job(monkeypatch):
+    seed, hint = seed_and_hint()
+    read = AsyncMock(side_effect=asyncio.TimeoutError)
+    monkeypatch.setattr('app.prospecting.sources.enrich_from_website', read)
+    cache = {}
+    for _ in range(2):
+        result, summary = await validate_discovery(AuthorizedSourceExecutor(), seed, campaign(), [],
+            known_hint=hint, analysis_accepted=True, site_cache=cache)
+        assert 'official_site_timeout' in result.review_flags
+        assert not result.import_eligible
+        assert summary['validation_outcome'] == 'read_failed'
+    read.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_known_site_read_once_before_analysis_and_negative_result_retains_fields(monkeypatch):
+    seed,hint=seed_and_hint()
+    source=AuthorizedSourceExecutor()
+    read=AsyncMock(return_value=enrichment(description='Instalacion de aire acondicionado'))
+    monkeypatch.setattr('app.prospecting.sources.enrich_from_website',read)
+    crm=FakeCRMPort()
+    async def research(*args,official_context):
+        assert official_context['name']=='Clima Andes'
+        assert official_context['activity']=='Instalacion de aire acondicionado'
+        assert read.await_count==1
+        return {'status':'applied','discoveries':[],'analysis_version':'climactiva-google-v1','analysis_accepted':False}
+    crm.research=research
+    crm.complete_enrichment=AsyncMock()
+    crm.fail_enrichment=AsyncMock(side_effect=AssertionError('Unexpected failure'))
+    job=SimpleNamespace(candidate=seed,discovery_hint=hint,snapshot=campaign(),job_id='job',run_id='run',lease_token='lease')
+    await ProspectingWorker(crm,MemoryWorkerStore(),source)._process_enrichment(job)
+    read.assert_awaited_once()
+    saved=crm.complete_enrichment.call_args.args[1]
+    assert saved.email and not saved.import_eligible
+
+
+def test_split_contact_address_keeps_locality_and_drops_contact_numbers():
+    html=b'<div><p>Direccion:</p><p>Av. Republica 100,</p><p>Rancagua, Chile</p><p>Email: ventas@andes.cl</p><p>Telefono: +56 72 1234567</p></div>'
+    info,_=_page_enrichment(SafeResponse('https://andes.cl/contacto',html,'text/html'))
+    assert info['phone']=='+56721234567'
+    assert any('Rancagua' in b['text'] and 'Republica 100' in b['text'] for b in info['address_blocks'])
+    assert all('@' not in b['text'] and '1234567' not in b['text'] for b in info['address_blocks'])
+
+
+def test_service_heading_is_preserved_without_using_navigation_as_business_evidence():
+    html=b'<meta name="description" content="Somos una empresa especialista en climatizacion y refrigeracion."><main><h2>Nuestro equipo realiza la instalacion. Trabajamos con sistemas de climatizacion y refrigeracion industrial.</h2></main>'
+    info,_=_page_enrichment(SafeResponse('https://andes.cl',html,'text/html'))
+    assert 'realiza la instalacion' in info['description']
+    assert info['field_sources']['description']=='https://andes.cl'
+
+
+def test_coverage_without_physical_address_does_not_create_branch():
+    html=b'<section><p>Direccion: Av. Norte 100, Santiago</p></section><p>Atendemos instalaciones en Rancagua</p>'
+    info,_=_page_enrichment(SafeResponse('https://andes.cl',html,'text/html'))
