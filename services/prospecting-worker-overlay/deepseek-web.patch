@@ -0,0 +1,76 @@
+from __future__ import annotations
+
+import httpx
+
+from app.prospecting.budget import brave_provider_usage_from_headers
+from app.prospecting.contracts import ProspectCandidate, ProspectLocation, SourceName
+from app.prospecting.scoring import classify_and_score
+from app.prospecting.store import WorkerTask
+from app.prospecting.validation import sanitize_unsubstantiated_external_fields, validate_candidate
+
+
+async def validate_discovery(executor, candidate, snapshot):
+    """One budgeted Brave lookup, followed by official evidence for this campaign."""
+    if not executor.settings.brave_search_api_key:
+        raise RuntimeError("Brave no esta configurado para validar el hallazgo")
+    if not {SourceName.brave_search, SourceName.official_website}.issubset(snapshot.campaign.sources):
+        raise RuntimeError("La campana requiere Brave y sitio oficial")
+    # A discovery URL may be a directory/PDF. Never use it as official evidence.
+    name = candidate.name.replace('"', ' ').strip()[:200]
+    query = f'"{name}" Chile sitio oficial'
+    task_id = f"discovery-{candidate.candidate_id}"
+    reservation = None
+    if executor.brave_budget:
+        reservation = await executor.brave_budget.reserve(
+            run_id=snapshot.crm_run_id, task_id=task_id, query=query,
+            monthly_limit_usd=snapshot.brave_policy.monthly_limit_usd,
+        )
+        if not reservation.allowed:
+            raise RuntimeError("Limite mensual de Brave alcanzado; candidato conservado")
+    async with httpx.AsyncClient(timeout=15, trust_env=False) as client:
+        response = await client.get("https://api.search.brave.com/res/v1/web/search",
+            headers={"Accept": "application/json", "X-Subscription-Token": executor.settings.brave_search_api_key},
+            params={"q": query, "count": 5, "country": "cl", "search_lang": "es", "safesearch": "moderate"})
+    if response.status_code != 200:
+        raise RuntimeError(f"Brave no pudo validar el candidato: HTTP {response.status_code}")
+    results = response.json().get("web", {}).get("results", [])
+    if reservation:
+        await executor.brave_budget.complete(reservation, len(results))
+        usage = brave_provider_usage_from_headers(response.headers)
+        if usage:
+            queries, limit, reset = usage
+            await executor.brave_budget.reconcile_provider_usage(provider_queries=queries,
+                provider_limit_queries=limit, provider_remaining_queries=max(0, limit-queries), reset_seconds=reset)
+    prepared = ProspectCandidate(candidate_id=candidate.candidate_id, name=candidate.name,
+        location=ProspectLocation(), market_signals={"deepseek_discovery": True})
+    for result in results[:5]:
+        url = result.get("url")
+        if not isinstance(url, str) or len(url)>2048:
+            continue
+        probe = prepared.model_copy(update={"website": url})
+        if not executor._is_official_website_candidate(probe):
+            continue
+        territory = snapshot.campaign.territories[0]
+        task = WorkerTask(id=task_id, run_id=snapshot.crm_run_id, source=SourceName.brave_search,
+            keyword=name, region_code=territory.region_code, region_name=territory.region_name or "",
+            comuna_code=territory.comuna_code, comuna_name=territory.comuna_name or "",
+            max_results=1, attempt_count=0, max_attempts=3)
+        # Full campaign scope, not the arbitrary first task's commune.
+        prepared = await executor._enrich_official_website(probe, task, snapshot)
+        break
+    prepared = sanitize_unsubstantiated_external_fields(classify_and_score(prepared, snapshot))
+    verdict = validate_candidate(prepared, snapshot)
+    reasons = list(verdict.reasons)
+    if not (prepared.phone or prepared.email):
+        reasons.append("missing_business_contact")
+    accepted = not reasons
+    prepared = prepared.model_copy(update={
+        "import_eligible": accepted,
+        "importable_location_indexes": tuple(range(len(prepared.locations))) if accepted else (),
+        "review_flags": tuple(dict.fromkeys(reasons)),
+    })
+    return prepared, {"validation_version": "deepseek-brave-v1", "brave_queries_used": 1,
+        "website_found": bool(prepared.website), "validation_accepted": accepted,
+        "validation_reasons": ", ".join(dict.fromkeys(reasons)),
+        "validation_message": "Datos contrastados con Brave y sitio oficial" if accepted else
+            "No se pudo confirmar empresa, contacto y territorio; conservado para revision"}
