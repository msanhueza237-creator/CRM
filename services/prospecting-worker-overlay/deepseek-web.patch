diff --git a/tests/test_deepseek_discovery.py b/tests/test_deepseek_discovery.py
new file mode 100644
index 0000000..68d501c
--- /dev/null
+++ b/tests/test_deepseek_discovery.py
@@ -0,0 +1,84 @@
+from types import SimpleNamespace
+
+import pytest
+
+from app.prospecting.contracts import ProspectingCampaign, ProspectingRunSnapshot, SourceName, Territory
+from app.prospecting.deepseek_discovery import discovery_candidates
+from app.prospecting.sources import AuthorizedSourceExecutor, SourceNotConfigured, SourceSearchResult
+from app.prospecting.validation import validate_candidate, sanitize_unsubstantiated_external_fields
+from app.prospecting.scoring import classify_and_score
+
+
+@pytest.mark.parametrize("url", ["https://www.homify.tw/professionals/empresa", "https://www.cylex.cl/santiago/empresa", "https://www.2x3.cl/profesional/empresa", "https://cl.todosnegocios.com/empresa", "https://www.aiyellow.com/empresa", "https://firmania.cl/santiago/empresa"])
+def test_search_directories_are_not_official_business_sites(url):
+    assert AuthorizedSourceExecutor._is_blocked_discovery_domain(url)
+
+
+def scope():
+    campaign = ProspectingCampaign(crm_campaign_id="campaign", name="Climatizacion Santiago",
+        keywords=("climatizacion",), sources=(SourceName.brave_search, SourceName.official_website),
+        territories=(Territory(region_code="13", region_name="Metropolitana de Santiago",
+            comuna_code="13101", comuna_name="Santiago"),))
+    hit = {"task_id": "task", "name": "Clima Andes - Aire acondicionado", "website": "https://climaandes.cl/", "source_url": "https://climaandes.cl/"}
+    snapshot = ProspectingRunSnapshot(crm_run_id="run", campaign_version=1, campaign=campaign,
+        requested_by="admin", deepseek_discoveries=[hit, hit])
+    task = SimpleNamespace(id="task", source=SourceName.brave_search, region_code="13", region_name="Metropolitana de Santiago",
+        comuna_code="13101", comuna_name="Santiago", keyword="climatizacion", max_results=20)
+    return snapshot, task
+
+
+def test_seeds_survive_contract_but_cannot_be_imported_without_official_evidence():
+    snapshot, task = scope()
+    parsed = ProspectingRunSnapshot.model_validate(snapshot.model_dump())
+    candidates = discovery_candidates(parsed, task)
+    assert len(candidates) == 1
+    candidate = candidates[0]
+    assert candidate.evidence == [] and candidate.provider_ids == {}
+    assert candidate.location.comuna_code is None and candidate.phone is None
+    assert not candidate.import_eligible
+    assert not validate_candidate(candidate, snapshot).accepted
+    task.id = "other-task"
+    assert discovery_candidates(parsed, task) == []
+
+
+@pytest.mark.asyncio
+async def test_deepseek_survives_brave_failure_and_enriches_from_official_site(monkeypatch):
+    snapshot, task = scope()
+    executor = AuthorizedSourceExecutor()
+    async def unavailable(*args):
+        raise SourceNotConfigured("Brave unavailable")
+    monkeypatch.setattr(executor, "_brave", unavailable)
+    result = await executor.search(task, snapshot)
+    assert len(result.candidates) == 1
+    assert result.metrics["brave_unavailable"]
+    assert result.metrics["deepseek_websites_researched"] == 1
+    async def official(website):
+        assert website == "https://climaandes.cl/"
+        return {"name": "Clima Andes", "source_url": website, "description": "Instalacion y mantencion de aire acondicionado",
+            "phone": "+56961234567", "email": "ventas@climaandes.cl",
+            "locations": [{"comuna_name": "Santiago", "region_name": "Metropolitana de Santiago", "address": "Av. Matta 100", "source_url": website}]}
+    monkeypatch.setattr("app.prospecting.sources.enrich_from_website", official)
+    enriched = await executor.enrich_discovered(result.candidates[0], task, snapshot)
+    assert enriched.name == "Clima Andes"
+    assert enriched.phone == "+56961234567"
+    assert enriched.location.comuna_code == "13101"
+    assert {e.provider for e in enriched.evidence} == {SourceName.official_website}
+    assert any(e.field == "name" and e.value == "Clima Andes" for e in enriched.evidence)
+    validated = validate_candidate(sanitize_unsubstantiated_external_fields(classify_and_score(enriched, snapshot)), snapshot)
+    assert validated.accepted, validated.reasons
+
+
+@pytest.mark.asyncio
+async def test_duplicate_sites_are_not_crawled_twice_and_brave_failures_without_seeds_still_fail(monkeypatch):
+    snapshot, task = scope()
+    executor = AuthorizedSourceExecutor()
+    async def brave(*args):
+        return SourceSearchResult(tuple(discovery_candidates(snapshot, task)), {})
+    monkeypatch.setattr(executor, "_brave", brave)
+    result = await executor.search(task, snapshot)
+    assert len(result.candidates) == 1 and result.metrics["deepseek_duplicates_merged"] == 1
+    async def unavailable(*args):
+        raise SourceNotConfigured("unavailable")
+    monkeypatch.setattr(executor, "_brave", unavailable)
+    with pytest.raises(SourceNotConfigured):
+        await executor.search(task, snapshot.model_copy(update={"deepseek_discoveries": []}))
