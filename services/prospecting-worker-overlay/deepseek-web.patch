+@pytest.mark.asyncio
+async def test_robots_redirect_validates_then_obeys_final_rules():
+    paths=[]
+    def handler(request):
+        paths.append(request.url.path)
+        if request.url.path=='/robots.txt': return httpx.Response(301,headers={'location':'/policy.txt'})
+        if request.url.path=='/policy.txt': return httpx.Response(200,text='User-agent: *\nDisallow: /')
+        raise AssertionError('Disallowed page was fetched')
+    client=SecureWebClient(resolver=public_resolver,transport=httpx.MockTransport(handler),min_host_interval=0)
+    assert (await enrich_from_website('https://andes.cl',client=client))['read_error']=='ROBOTS_DENIED'
+    assert paths==['/robots.txt','/policy.txt']
