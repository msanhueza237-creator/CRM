diff --git a/app/prospecting/deepseek_discovery.py b/app/prospecting/deepseek_discovery.py
new file mode 100644
index 0000000..36efc9e
--- /dev/null
+++ b/app/prospecting/deepseek_discovery.py
@@ -0,0 +1,30 @@
+"""Unverified search seeds; official-site enrichment supplies all field evidence."""
+from urllib.parse import urlsplit
+
+from app.prospecting.contracts import ProspectCandidate, ProspectLocation
+
+
+def discovery_candidates(snapshot, task):
+    results = []
+    hosts = set()
+    for hit in snapshot.deepseek_discoveries[:30]:
+        if hit.get("task_id") != task.id:
+            continue
+        website = hit.get("website", "")
+        name = hit.get("name", "").strip()[:300]
+        try:
+            url = urlsplit(website)
+            host = (url.hostname or "").lower().removeprefix("www.")
+            if (url.scheme not in ("http", "https") or url.username or url.password
+                    or url.port or not host or "." not in host or len(website) > 1000):
+                continue
+        except ValueError:
+            continue
+        if not name or host in hosts or hit.get("source_url") != website:
+            continue
+        hosts.add(host)
+        results.append(ProspectCandidate(
+            name=name, website=website, location=ProspectLocation(),
+            market_signals={"deepseek_discovery": True},
+        ))
+    return results
diff --git a/app/prospecting/discovery_validation.py b/app/prospecting/discovery_validation.py
new file mode 100644
index 0000000..b1ee260
--- /dev/null
+++ b/app/prospecting/discovery_validation.py
@@ -0,0 +1,46 @@
+from __future__ import annotations
+
+from app.prospecting.contracts import ProspectCandidate, ProspectLocation, SourceName
+from app.prospecting.scoring import classify_and_score
+from app.prospecting.store import WorkerTask
+from app.prospecting.validation import sanitize_unsubstantiated_external_fields, validate_candidate
+
+
+async def validate_discovery(executor, candidate, snapshot, research_urls=None):
+    """Only verified official fields can promote a public search hint."""
+    if SourceName.official_website not in snapshot.campaign.sources:
+        raise RuntimeError("La campana requiere una fuente oficial para verificar datos")
+    prepared = ProspectCandidate(candidate_id=candidate.candidate_id, name=candidate.name,
+        location=ProspectLocation(), market_signals={"deepseek_discovery": True})
+    urls = [candidate.website] if executor._is_official_website_candidate(candidate) else list(research_urls or [])
+    territory = snapshot.campaign.territories[0]
+    task = WorkerTask(id=f"discovery-{candidate.candidate_id}", run_id=snapshot.crm_run_id,
+        source=SourceName.deepseek_web, keyword=candidate.name[:200], region_code=territory.region_code,
+        region_name=territory.region_name, comuna_code=territory.comuna_code,
+        comuna_name=territory.comuna_name, max_results=1, attempt_count=0, max_attempts=3)
+    for url in urls[:5]:
+        if not isinstance(url, str) or len(url)>2048:
+            continue
+        probe = prepared.model_copy(update={"website": url})
+        if not executor._is_official_website_candidate(probe):
+            continue
+        enriched = await executor._enrich_official_website(probe, task, snapshot)
+        if any(e.provider == SourceName.official_website and e.field == "name" for e in enriched.evidence):
+            prepared = enriched
+            break
+    prepared = sanitize_unsubstantiated_external_fields(classify_and_score(prepared, snapshot))
+    reasons = list(validate_candidate(prepared, snapshot).reasons)
+    if not (prepared.phone or prepared.email):
+        reasons.append("missing_business_contact")
+    official = any(e.provider == SourceName.official_website and e.field == "name" for e in prepared.evidence)
+    if not official:
+        reasons.append("missing_official_identity")
+    accepted = not reasons
+    prepared = prepared.model_copy(update={"import_eligible": accepted,
+        "importable_location_indexes": tuple(range(len(prepared.locations))) if accepted else (),
+        "review_flags": tuple(dict.fromkeys(reasons))})
+    return prepared, {"validation_version": "public-web-v3", "official_pages_verified": int(official),
+        "website_found": bool(prepared.website), "validation_accepted": accepted,
+        "validation_reasons": ", ".join(dict.fromkeys(reasons)),
+        "validation_message": "Identidad, contacto y territorio verificados en sitio oficial" if accepted else
+            "Evidencia publica insuficiente; candidato conservado para revision"}
