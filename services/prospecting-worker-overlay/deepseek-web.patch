@@ -0,0 +1,99 @@
+from __future__ import annotations
+from datetime import datetime, timezone
+
+from app.prospecting.contracts import ProspectCandidate, ProspectLocation, SourceName
+from app.prospecting.scoring import classify_and_score
+from app.prospecting.store import WorkerTask
+from app.prospecting.validation import sanitize_unsubstantiated_external_fields, validate_candidate
+from app.prospecting.site_quality import site_issue, same_site
+from app.prospecting.quality import commercial_channel
+
+
+def current_google_hint(hint, candidate):
+    if not hint or not candidate.candidate_id or hint.candidate_id != candidate.candidate_id or not hint.website:
+        return None
+    now = datetime.now(timezone.utc)
+    valid = {e.field: e.value for e in hint.evidence if e.provider == SourceName.google_places
+        and e.retention_until and e.retention_until > now and e.observed_at <= now}
+    if valid.get("website") != hint.website or valid.get("name") != hint.name:
+        return None
+    # Hints are ephemeral matching aids, never official evidence in the result.
+    location = hint.location.model_copy(update={"address": valid.get("location.address"),
+        "comuna_name": valid.get("location.comuna_name")})
+    return hint.model_copy(update={"phone": valid.get("phone"), "location": location})
+
+
+async def validate_discovery(executor, candidate, snapshot, research_urls=None, *, known_hint=None, analysis_accepted=None, site_cache=None):
+    """Only verified official fields can promote a public search hint."""
+    if SourceName.official_website not in snapshot.campaign.sources:
+        raise RuntimeError("La campana requiere una fuente oficial para verificar datos")
+    prepared = ProspectCandidate(candidate_id=candidate.candidate_id, name=candidate.name,
+        location=ProspectLocation(), market_signals={
+            "google_discovery" if candidate.market_signals.get("google_discovery") else "deepseek_discovery": True})
+    empty = prepared.model_copy(deep=True)
+    # An explicit empty analysis is not permission to fall back to the original site.
+    urls = list(research_urls) if research_urls is not None else (
+        [candidate.website] if executor._is_official_website_candidate(candidate) else [])
+    hint = current_google_hint(known_hint, candidate)
+    if hint and not site_issue(hint.website) and not executor._is_blocked_discovery_domain(hint.website):
+        urls = list(dict.fromkeys([hint.website, *urls]))
+    origin_issue = site_issue(candidate.website)
+    territory = snapshot.campaign.territories[0]
+    task = WorkerTask(id=f"discovery-{candidate.candidate_id}", run_id=snapshot.crm_run_id,
+        source=SourceName.deepseek_web, keyword=candidate.name[:200], region_code=territory.region_code,
+        region_name=territory.region_name, comuna_code=territory.comuna_code,
+        comuna_name=territory.comuna_name, max_results=1, attempt_count=0, max_attempts=3)
+    for url in urls[:5]:
+        if not isinstance(url, str) or len(url)>2048:
+            continue
+        probe = empty.model_copy(deep=True, update={"website": url})
+        if not (hint and same_site(hint.website, url)) and not executor._is_official_website_candidate(probe):
+            continue
+        options = {"known_hint": hint} if hint else {}
+        if site_cache is not None:
+            options["site_cache"] = site_cache
+        enriched = await executor._enrich_official_website(probe, task, snapshot, **options)
+        # A second unreadable or unrelated page must not erase verified fields.
+        if len(enriched.evidence) > len(prepared.evidence) or not prepared.website:
+            prepared = enriched
+        if (any(e.provider == SourceName.official_website and e.field == "name" for e in enriched.evidence)
+            and enriched.location.comuna_code and (enriched.phone or enriched.email)):
+            break
+    prepared = sanitize_unsubstantiated_external_fields(classify_and_score(prepared, snapshot))
+    reasons = [*prepared.review_flags, *validate_candidate(prepared, snapshot).reasons]
+    if origin_issue and not urls:
+        reasons.append(origin_issue)
+    if not prepared.description or len(prepared.description.strip()) < 20:
+        reasons.append("missing_business_activity")
+    if not prepared.location.address:
+        reasons.append("missing_business_address")
+    if not (prepared.phone or prepared.email):
+        reasons.append("missing_business_contact")
+    official = any(e.provider == SourceName.official_website and e.field == "name" for e in prepared.evidence)
+    if not official:
+        reasons.append("missing_official_identity")
+    channel = commercial_channel(prepared.description or "", bool(prepared.location.address))
+    if not channel:
+        reasons.append("commercial_profile_unconfirmed")
+    if hint and research_urls is not None and analysis_accepted is not True:
+        reasons.append("analysis_not_confirmed")
+    if not prepared.description:
+        reasons = [r for r in reasons if r != "not_hvac_related"]
+    accepted = not reasons
+    prepared = prepared.model_copy(update={"import_eligible": accepted,
+        "score": prepared.score if accepted else 0, "market_score": prepared.market_score if accepted else 0,
+        "importable_location_indexes": tuple(range(len(prepared.locations))) if accepted else (),
+        "review_flags": tuple(dict.fromkeys(reasons))})
+    read_error = next((r for r in reasons if r in {"official_robots_denied", "official_robots_unavailable", "official_site_unsafe", "official_site_unavailable", "official_site_timeout", "official_site_unreadable"}), None)
+    outside = any(r in {"excluded_business_type", "foreign_country", "foreign_phone", "foreign_contact", "outside_target_types", "directory_or_non_business"} for r in reasons)
+    outcome = "qualified" if accepted else "outside_profile" if outside else "read_failed" if read_error else "incomplete_evidence"
+    return prepared, {"validation_version": "public-web-v4", "official_pages_verified": int(official),
+        "enrichment_version": "retained-sites-v1", "validation_outcome": outcome, "known_site_reused": bool(hint),
+        "commercial_profile_version": "climactiva-buyer-v1", "commercial_channel": channel or "unconfirmed",
+        "website_found": bool(prepared.website), "validation_accepted": accepted,
+        "validation_reasons": ", ".join(dict.fromkeys(reasons)),
+        "validation_message": "Identidad, contacto y territorio verificados en sitio oficial" if accepted else
+            "La evidencia confirma un rubro o territorio fuera del perfil" if outside else
+            "Lectura del sitio pendiente; no equivale a una empresa fuera del rubro" if read_error else
+            "Evidencia oficial conservada; faltan comprobaciones para admitir como contactable" if official else
+            "Falta verificar identidad y datos en una fuente oficial; no se ha descartado por rubro"}
